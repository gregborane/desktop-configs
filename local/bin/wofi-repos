#!/bin/sh
set -eu

terminal="xdg-terminal-exec"

# Pick project
configs="$(
    for dir in "$HOME"/Work/*/; do
        [ -d "$dir" ] || continue
        basename "$dir"
    done
)"

[ -n "$configs" ] || exit 0

chosen="$(printf '%s\n' "$configs" | wofi --dmenu -p 'Projects:')" || exit 0
[ -n "$chosen" ] || exit 0

dir="$HOME/Work/$chosen"

# Launch terminal in project directory with Neovim
exec "$terminal" --dir="$dir" nvim .
