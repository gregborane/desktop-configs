#!/bin/bash

# Load conda
CONDA_BASE=$(conda info --base)
source "$CONDA_BASE/etc/profile.d/conda.sh"

# Packages passed as arguments
# PACKAGES="$@"

# Loop through all environments
for env in $(conda env list | awk 'NR>2 {print $1}'); do
    if $env == "#"; then
        echo "skipping info in channel"
    else; then
    conda activate $env
    pip install $PACKAGES
    fi
done
echo "Pip install completed in all environments"
