
set $mod Mod4
set $alt Mod1
set $ipc noctalia msg
set $terminal xdg-terminal-exec
set $filemanager xdg-filemanager-exec
set $browser xdg-browser-exec

# Minimal decoration, matching the original Hyprland gaps and borders.
font SF Mono 12
default_border pixel 1
default_floating_border pixel 1
gaps inner 1
gaps outer 1
client.focused          #ffffff #181818 #ffffff #ffffff #ffffff
client.focused_inactive #000000 #181818 #888888 #000000 #000000
client.unfocused        #000000 #181818 #888888 #000000 #000000
client.urgent           #ff5555 #181818 #ffffff #ff5555 #ff5555

# Laptop output comes from original Hyprland config.
# If 1920x1200@60Hz is not offered, remove 'mode' and let Sway choose.
output eDP-1 mode 1920x1200@60Hz position 0 0 scale 1

# Original layout: workspaces 1-3 on HDMI-A-1; 4-6 on eDP-1.
# Fallback to the laptop panel for 1-3 if HDMI-A-1 is disconnected.
workspace 1 output HDMI-A-1 eDP-1
workspace 2 output HDMI-A-1 eDP-1
workspace 3 output HDMI-A-1 eDP-1
workspace 4 output eDP-1
workspace 5 output eDP-1
workspace 6 output eDP-1

input type:keyboard {
    xkb_layout us
    xkb_variant altgr-intl
    xkb_model pc105
    xkb_options lv3:caps_switch
}
input type:touchpad {
    natural_scroll enabled
}
focus_follows_mouse yes
seat * hide_cursor when-typing enable
seat * xcursor_theme Bibata-Modern-Ice 24
floating_modifier $alt normal
for_window [app_id="^.*"] inhibit_idle fullscreen

# Ensure PipeWire/portals launched via D-Bus see the Sway session.
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# Noctalia owns bar, wallpaper, notification daemon, launcher, and lock screen.
exec noctalia
exec swaymonad --default-layout tall

# Applications 
bindsym $mod+Return exec $terminal
bindsym $mod+b exec $filemanager
bindsym $mod+y exec $browser
bindsym $mod+space exec $ipc panel-toggle launcher
bindsym $mod+r exec wofi-repos
bindsym $mod+Shift+l exec $ipc session lock
bindsym $mod+c exec sh -c 'cat "$HOME/Documents/PhD/papers/prompt.md" | wl-copy'
bindsym --no-repeat $mod+a exec $ipc bar-show 
bindsym --release $mod+a exec $ipc bar-hide 

# Window management.
bindsym $mod+q kill
bindsym $mod+Mod1+m exec $ipc session logout
bindsym $mod+t floating toggle
bindsym $mod+Shift+j layout toggle split
bindsym $mod+f fullscreen toggle
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+h move left
bindsym $mod+j move right
bindsym $mod+k move up
bindsym $mod+l move down
bindsym $alt+Tab focus next

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym Ctrl+Mod1+Left workspace prev_on_output
bindsym Ctrl+Mod1+Right workspace next_on_output

# Resize in 30px increments as before.
bindsym $mod+Shift+Right resize grow width 30 px
bindsym $mod+Shift+Left resize shrink width 30 px
bindsym $mod+Shift+Up resize grow height 30 px
bindsym $mod+Shift+Down resize shrink height 30 px

# Use wpctl and brightnessctl directly, preserving your original tools.
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl s +5%
bindsym --locked XF86MonBrightnessDown exec brightnessctl s 5%-

# Native Noctalia notifications and Wayland screenshot tools.
bindsym $mod+comma exec $ipc notification-clear-active
bindsym $mod+Shift+comma exec $ipc notification-dnd-toggle
bindsym Print exec $ipc screenshot-region
bindsym $mod+s exec $ipc screenshot-region

# Original Steam rules (Xwayland typically exposes class=steam).
for_window [class="^steam$"] floating enable
for_window [class="^steam$"] inhibit_idle fullscreen
for_window [class="^steam$" title="^Steam$"] resize set 1100 700, move position center
for_window [class="^steam$" title="^Friends List$"] resize set 460 800
for_window [app_id="com.Util"] floating enable, resize set 950 800, move position center

# Optional: one-command config reload without re-running exec lines.
bindsym $mod+Ctrl+r reload
