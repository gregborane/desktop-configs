{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "$HOME/.config/fastfetch/pfp2.png",
    "width": 40,
    "height": 18,
    "padding": {
      "top": 1,
      "left": 0,
      "right": 1
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    // --- Hardware Section ---
    {
    "type": "custom",
    "format": ""
    },
    {
    "type": "custom",
    "format": ""
    },
    {
      "type": "custom",
      "format": "┌───────────────────── Hardware ─────────────────────┐"
    },
    {
      "type": "cpu",
      "key": " ├─  ",
      "keyColor": "38;5;240"
    },
    {
      "type": "gpu",
      "key": " ├─ 󰍛 ",
      "keyColor": "38;5;240"
    },
    { "type": "display",
      "key": " ├─ 󱄄 ",
      "keyColor": "38;5;240" 
    },
    {
     "type": "disk",
     "key": " ├─ 󰋊 ",
     "keyColor": "38;5;240"
    },
    {
      "type": "memory",
      "key": " ├─ 󰘚 ",
      "keyColor": "38;5;240"
    },
    {
      "type": "swap",
      "key": " └─ 󰓡 ",
      "keyColor": "38;5;240"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────┘"
    },


    // --- Software Section ---
    {
      "type": "custom",
      "format": "┌───────────────────── Software ─────────────────────┐"
    },
    {
      "type": "os",
      "key": " ├─ 󰌽 ",
      "keyColor": "38;5;240"
    },
    {
      "type": "kernel",
      "key": " ├─  ",
      "keyColor": "38;5;240"
    },
    {
      "type": "wm",
      "key": " ├─ 󰨇 ",
      "keyColor": "38;5;240"
    },
    { 
      "type": "de",
      "key": " ├─  ",
      "keyColor": "38;5;240" 
    },
    { 
      "type": "packages",
      "key": " ├─ 󰏖 ",
      "keyColor": "38;5;240" },
    {
      "type": "terminal",
      "key": " ├─ 󰞷 ",
      "keyColor": "38;5;240"
    },
    { 
      "type": "terminalfont",
      "key": " ├─  ",
      "keyColor": "38;5;240"
    },
    {
      "type": "shell",
      "key": " └─ 󰞷 ",
      "keyColor": "38;5;240"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────┘"
    },
    { 
      "type": "custom",
      "format": "┌──────────────────┤ Uptime / Age ├──────────────────┐" 
    },

    { 
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "38;5;240",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days" 
    },

{ 
  "type": "uptime",
  "key": "󱫐 Uptime",
  "keyColor": "38;5;240" 
},

{ 
  "type": "custom",
  "format": "└────────────────────────────────────────────────────┘" 
},

"break"

  ]
}
