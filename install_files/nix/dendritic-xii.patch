diff --git a/install_files/nix/dentritic/modules/hardware/xii-boot.nix b/install_files/nix/dentritic/modules/hardware/xii-boot.nix
new file mode 100644
index 00000000..7fd4848e
--- /dev/null
+++ b/install_files/nix/dentritic/modules/hardware/xii-boot.nix
@@ -0,0 +1,80 @@
+{
+  flake.modules.nixos.xii-boot = { pkgs, ... }: {
+    boot = {
+      kernelPackages = pkgs.linuxPackages_latest;
+
+      kernelParams = [
+        "quiet"
+        "rd.udev.log_level=3"
+        "rd.systemd.show_status=auto"
+        "preempt=lazy"
+      ];
+
+      kernel.sysfs = {
+        kernel.mm.transparent_hugepage = {
+          enabled = "madvise";
+          defrag = "defer";
+          shmem_enabled = "within_size";
+        };
+      };
+
+      zswap.enable = false;
+
+      # -------------------------------------------------------------------------
+      # Bootloader
+      # -------------------------------------------------------------------------
+
+      loader = {
+        efi.canTouchEfiVariables = true;
+        timeout = 5;
+
+        systemd-boot = {
+          enable = true;
+          configurationLimit = 8;
+          editor = false;
+        };
+      };
+
+      # -------------------------------------------------------------------------
+      # Initrd
+      # -------------------------------------------------------------------------
+
+      initrd = {
+        systemd.enable = true;
+        verbose = false;
+
+        # LUKS devices and LVM are configured separately
+        # in storage-configuration.nix.
+      };
+
+      # -------------------------------------------------------------------------
+      # Plymouth
+      # -------------------------------------------------------------------------
+
+      plymouth = {
+        enable = true;
+        theme = "watch-dogs";
+
+        themePackages = [
+          (pkgs.runCommand "watch-dogs-plymouth-theme" { } ''
+            themeDir="$out/share/plymouth/themes/watch-dogs"
+
+            mkdir -p "$themeDir"
+            cp -r ${../../../../../config/watch-dogs}/. "$themeDir/"
+
+            substituteInPlace "$themeDir/watch-dogs.plymouth" \
+              --replace-fail \
+              "/usr/share/plymouth/themes/watch-dogs" \
+              "$themeDir"
+          '')
+        ];
+      };
+    };
+    zramSwap = {
+      enable = true;
+      algorithm = "lz4";
+      memoryPercent = 50;
+      priority = 100;
+    };
+  };
+}
diff --git a/install_files/nix/dentritic/modules/hosts/xii.nix b/install_files/nix/dentritic/modules/hosts/xii.nix
new file mode 100644
index 00000000..3bdca6fc
--- /dev/null
+++ b/install_files/nix/dentritic/modules/hosts/xii.nix
@@ -0,0 +1,78 @@
+{ inputs, config, ... }:
+{
+  flake.nixosConfigurations.xii = inputs.nixpkgs.lib.nixosSystem {
+    modules =
+      (with config.flake.modules.nixos; [
+        xii-boot
+        power
+        amd
+        bluetooth
+        audio
+        polkit
+        ssh
+        tailscale
+        integration
+        nix
+        fonts
+        sway
+        bash
+        git
+        cli-packages
+        desktop-packages
+        development-packages
+        chromium
+        omnisearch
+        greg
+      ])
+      ++ [
+        ../../hosts/xii/hardware-configuration.nix
+        ../../hosts/xii/storage-configuration.nix
+        inputs.home-manager.nixosModules.home-manager
+        {
+          home-manager = {
+            useGlobalPkgs = true;
+            useUserPackages = true;
+            backupFileExtension = "backup";
+            users.greg.imports = [ config.flake.modules.homeManager.greg ];
+          };
+          services.omnisearch = {
+            enable = true;
+            settings.server = {
+              host = "127.0.0.1";
+              port = 8087;
+            };
+          };
+          services.openssh.settings.AllowUsers = [ "greg" ];
+          services.getty.autologinUser = "greg";
+          networking = {
+            hostName = "xii";
+
+            networkmanager = {
+              enable = true;
+              wifi.scanRandMacAddress = false;
+            };
+
+            firewall.enable = true;
+
+            enableIPv6 = false;
+
+            hosts = {
+              "100.86.86.51" = [
+                "greg-desktop"
+              ];
+
+              "100.110.31.78" = [
+                "greg-phone"
+              ];
+
+              "100.118.211.88" = [
+                "greg-initrd"
+              ];
+            };
+          };
+          time.timeZone = "Canada/Eastern";
+          system.stateVersion = "26.05";
+        }
+      ];
+  };
+}
