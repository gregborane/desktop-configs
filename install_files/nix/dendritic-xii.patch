+          type = "folder";
+          children = [
+            {
+              name = "ChatGPT";
+              type = "url";
+              url = "https://chatgpt.com";
+            }
+            {
+              name = "NotebookLM";
+              type = "url";
+              url = "https://notebooklm.google.com";
+            }
+            {
+              name = "ResearchRabbit";
+              type = "url";
+              url = "https://app.researchrabbit.ai";
+            }
+          ];
+        }
+        {
+          name = "local";
+          type = "folder";
+          children = [
+            {
+              name = "Downloads";
+              type = "url";
+              url = "file:///home/greg/Downloads/";
+            }
+            {
+              name = "Documents";
+              type = "url";
+              url = "file:///home/greg/Documents/";
+            }
+            {
+              name = "PhD";
+              type = "url";
+              url = "file:///home/greg/Documents/PhD/";
+            }
+          ];
+        }
+        {
+          name = "school";
+          type = "folder";
+          children = [
+            {
+              name = "Moodle PolyMTL";
+              type = "url";
+              url = "https://moodle.polymtl.ca";
+            }
+            {
+              name = "CADET-Core";
+              type = "url";
+              url = "https://cadet.github.io";
+            }
+            {
+              name = "Dossier étudiant PolyMTL";
+              type = "url";
+              url = "https://dossieretudiant.polymtl.ca";
+            }
+            {
+              name = "SharePoint PolyMTL";
+              type = "url";
+              url = "https://polymtlca-my.sharepoint.com";
+            }
+          ];
+        }
+        {
+          name = "journals";
+          type = "folder";
+          children = [
+            {
+              name = "Web of Science";
+              type = "url";
+              url = "https://www.webofscience.com/wos/woscc/smart-search";
+            }
+            {
+              name = "Elservier";
+              type = "url";
+              url = "https://www.elsevier.com/products/journals";
