-        snprintf(form, len, "q=%s", escaped);
-        curl_easy_setopt(job->handle, CURLOPT_URL,
-                         "https://lite.duckduckgo.com/lite/");
-        curl_easy_setopt(job->handle, CURLOPT_COPYPOSTFIELDS, form);
-        free(form);
-      }
-      curl_free(escaped);
